<div class="min-h-screen bg-[#FFF0F1]">
  <!-- Navigation -->
  <nav class="bg-white border-b-4 border-black p-4">
    <div class="max-w-6xl mx-auto flex justify-between items-center">
      <h1 class="text-xl font-black text-black">Resume Optimizer</h1>
      <div class="flex gap-3">
        <%= link_to "Home", root_path, class: "px-3 py-2 text-sm bg-white text-black font-bold border-2 border-black shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-[1px_1px_0px_0px_rgba(0,0,0,1)] transition-all" %>
        <%= link_to "Template", llm_show_path, class: "px-3 py-2 text-sm bg-[#FF4757] text-white font-bold border-2 border-black shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-[1px_1px_0px_0px_rgba(0,0,0,1)] transition-all" %>
        <%= link_to "Optimize", llm_submit_path, class: "px-3 py-2 text-sm bg-white text-black font-bold border-2 border-black shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-[1px_1px_0px_0px_rgba(0,0,0,1)] transition-all" %>
      </div>
    </div>
  </nav>

  <!-- Header -->
  <section class="py-6 px-4">
    <div class="max-w-6xl mx-auto">
      <div class="bg-[#FF4757] border-4 border-black shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] p-6">
        <h1 class="text-2xl md:text-3xl font-black text-white uppercase">Resume HTML Template</h1>
        <p class="text-white text-sm font-bold mt-2">Copy the template below to use as your resume base</p>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <section class="pb-12 px-4">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Left Column: Preview -->
        <div class="bg-white border-4 border-black shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] w-full">
          <div class="bg-[#FF4757] border-b-4 border-black p-3">
            <h2 class="text-lg font-black text-white uppercase">Preview</h2>
          </div>
          <div class="p-4">
            <iframe id="templatePreview" class="w-full border-0" style="height: 500px;"></iframe>
          </div>
        </div>

        <!-- Right Column: Source Code -->
        <div class="bg-black border-4 border-black shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] w-full">
          <div class="bg-[#FF4757] border-b-4 border-black p-3 flex justify-between items-center">
            <h2 class="text-lg font-black text-white uppercase">Source Code</h2>
            <button onclick="copyTemplate()"
              class="px-3 py-1 bg-white text-black font-bold border-2 border-black shadow-[2px_2px_0px_0px_rgba(255,255,255,0.5)] hover:translate-x-[1px] hover:translate-y-[1px] hover:shadow-none transition-all text-xs">
              Copy
            </button>
          </div>
          <pre id="templateCode" class="p-4 text-xs text-green-400 overflow-auto max-h-[500px] font-mono whitespace-pre-wrap break-all"><code><%= h @template %></code></pre>
        </div>
      </div>

      <!-- Copy Button -->
      <div class="mt-6 text-center">
        <button onclick="copyTemplate()"
          class="px-8 py-3 bg-[#FF4757] text-white font-black text-sm border-4 border-black shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] hover:translate-x-[3px] hover:translate-y-[3px] hover:shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] transition-all uppercase">
          Copy HTML Template
        </button>
        <span id="copyStatus" class="block mt-3 text-green-600 font-black text-sm hidden">Copied to clipboard!</span>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-black text-white py-4 px-4 border-t-4 border-[#FF4757]">
    <div class="max-w-6xl mx-auto text-center">
      <p class="font-bold text-sm">Built with Ruby on Rails + Tailwind CSS</p>
    </div>
  </footer>
</div>


<textarea id="hiddenTemplate" class="absolute -left-[9999px]"><%= @template %></textarea>

<script>
  // Load template into iframe for proper isolation
  (function() {
    var iframe = document.getElementById('templatePreview');
    var template = document.getElementById('hiddenTemplate').value;
    var doc = iframe.contentDocument || iframe.contentWindow.document;
    doc.open();
    doc.write(template);
    doc.close();
  })();

  function copyTemplate() {
    var textarea = document.getElementById('hiddenTemplate');
    textarea.select();
    textarea.setSelectionRange(0, 99999);

    try {
      document.execCommand('copy');
      var status = document.getElementById('copyStatus');
      status.classList.remove('hidden');
      setTimeout(function() {
        status.classList.add('hidden');
      }, 2000);
    } catch (err) {
      alert('Failed to copy. Please select the code manually and copy.');
    }
  }
</script>
